<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFrameworks>net48;netstandard2.0;net10.0</TargetFrameworks>
        <Title>CDP4Dal Community Edition</Title>
        <Description>CDP4 Data Access Layer library, a consumer of an ECSS-E-TM-10-25 Annex C API</Description>
        <PackageId>CDP4Dal-CE</PackageId>
        <PackageReleaseNotes>
            - [Update] dependencies
            - [Fix] AuthenticationTokenRefreshService.StartAsync throwing when disposed during a refresh; fixes #411
            - [Fix] AuthenticationTokenRefreshService using TimeSpan.Seconds instead of TotalSeconds for the refresh delay; fixes #412
        </PackageReleaseNotes>
    </PropertyGroup>

    <ItemGroup>
        <ProjectReference Include="..\CDP4DalCommon\CDP4DalCommon.csproj" />
    </ItemGroup>

    <ItemGroup Condition="'$(TargetFramework)' == 'net48' ">
        <Reference Include="System.ComponentModel.Composition" />
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="System.Reactive" />
    </ItemGroup>

</Project>
