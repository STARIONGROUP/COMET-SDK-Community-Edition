<Project>

    <!--
        Central Package Management: every NuGet package version used in the solution is set here.
        Projects reference packages with <PackageReference Include="..." /> and no Version attribute.
    -->
    <PropertyGroup>
        <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    </PropertyGroup>

    <ItemGroup Label="build-only dependencies, added to every project">
        <GlobalPackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" />
    </ItemGroup>

    <ItemGroup Label="library dependencies">
        <PackageVersion Include="FluentResults" Version="4.0.0" />
        <PackageVersion Include="MessagePack" Version="3.1.7" />
        <PackageVersion Include="Microsoft.AspNet.WebApi.Client" Version="6.0.0" />
        <PackageVersion Include="Microsoft.Extensions.Configuration.Abstractions" Version="10.0.9" />
        <PackageVersion Include="Microsoft.Extensions.Configuration.Binder" Version="10.0.9" />
        <PackageVersion Include="Microsoft.Extensions.Hosting.Abstractions" Version="10.0.9" />
        <PackageVersion Include="Microsoft.Sbom.Targets" Version="4.1.5" />
        <PackageVersion Include="NLog" Version="6.1.3" />
        <PackageVersion Include="Polly" Version="8.7.0" />
        <PackageVersion Include="RabbitMQ.Client" Version="7.2.1" />
        <PackageVersion Include="SharpZipLib" Version="1.4.2" />
        <PackageVersion Include="System.IdentityModel.Tokens.Jwt" Version="8.19.1" />
        <PackageVersion Include="System.IO.Pipelines" Version="10.0.9" />
        <PackageVersion Include="System.Net.Http" Version="4.3.4" />
        <PackageVersion Include="System.Reactive" Version="6.1.0" />
        <PackageVersion Include="System.Text.Json" Version="10.0.9" />
        <PackageVersion Include="System.ValueTuple" Version="4.6.2" />
        <PackageVersion Include="System.Xml.XmlSerializer" Version="4.3.0" />
    </ItemGroup>

    <ItemGroup Label="overrides of vulnerable or outdated transitive dependencies">
        <PackageVersion Include="System.Buffers" Version="4.6.1" />
        <PackageVersion Include="System.Drawing.Common" Version="10.0.9" />
        <PackageVersion Include="System.Memory" Version="4.6.3" />
        <PackageVersion Include="System.Numerics.Vectors" Version="4.6.1" />
        <PackageVersion Include="System.Runtime.CompilerServices.Unsafe" Version="6.1.2" />
        <PackageVersion Include="System.Text.RegularExpressions" Version="4.3.1" />
        <PackageVersion Include="System.Threading.Tasks.Extensions" Version="4.6.3" />
    </ItemGroup>

    <ItemGroup Label="test dependencies">
        <PackageVersion Include="coverlet.collector" Version="10.0.1" />
        <PackageVersion Include="coverlet.msbuild" Version="10.0.1" />
        <PackageVersion Include="JetBrains.dotMemoryUnit" Version="3.2.20220510" />
        <PackageVersion Include="MELT" Version="1.1.0" />
        <PackageVersion Include="Microsoft.Extensions.Logging" Version="10.0.9" />
        <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="18.7.0" />
        <PackageVersion Include="Moq" Version="4.20.72" />
        <PackageVersion Include="NUnit" Version="4.6.1" />
        <PackageVersion Include="NUnit.Console" Version="3.22.0" />
        <PackageVersion Include="NUnit3TestAdapter" Version="6.2.0" />
        <PackageVersion Include="RichardSzalay.MockHttp" Version="7.0.0" />
    </ItemGroup>

</Project>
