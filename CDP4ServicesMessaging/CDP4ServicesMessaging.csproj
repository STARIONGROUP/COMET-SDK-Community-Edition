<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFrameworks>netstandard2.0;net10.0</TargetFrameworks>
        <Title>CDP4ServicesMessaging Community Edition</Title>
        <Description>CDP4 Services Messaging is a Class Library that contains clients and messages class that can be used for inter services communication</Description>
        <PackageId>CDP4ServicesMessaging-CE</PackageId>
        <PackageReleaseNotes>
            [Update] Microsoft.Extensions.Configuration.Abstractions to version 10.0.14
            [Update] Microsoft.Extensions.Configuration.Binder to version 10.0.14
            [Update] Microsoft.Extensions.Hosting.Abstractions to version 10.0.14
            [Update] Polly to version 8.9.0
            [Update] RabbitMQ.Client to version 7.2.2
            [Update] CDP4Dal to version 30.1.4
            [Update] CDP4JsonSerializer to version 30.1.4
            [Implement] SQ improvements (#400)
        </PackageReleaseNotes>
    </PropertyGroup>

    <ItemGroup>
        <ProjectReference Include="..\CDP4Dal\CDP4Dal.csproj" />
        <ProjectReference Include="..\CDP4JsonSerializer\CDP4JsonSerializer.csproj" />
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="Microsoft.Extensions.Configuration.Abstractions" />
        <PackageReference Include="Microsoft.Extensions.Configuration.Binder" />
        <PackageReference Include="Microsoft.Extensions.Hosting.Abstractions" />
        <PackageReference Include="Polly" />
        <PackageReference Include="RabbitMQ.Client" />
    </ItemGroup>

</Project>
