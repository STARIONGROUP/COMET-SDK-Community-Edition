<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFrameworks>net48;netstandard2.0;net10.0</TargetFrameworks>
        <Title>CDP4JsonSerializer Community Edition</Title>
        <Description>CDP4 JSON Serialization Library</Description>
        <PackageId>CDP4JsonSerializer-CE</PackageId>
        <PackageTags>CDP COMET ECSS-E-TM-10-25 JSON MBSE</PackageTags>
        <PackageReleaseNotes>
            - [Add] SerializeThing and SerializeClasslessDto overloads that write UTF-8 JSON to a Utf8JsonWriter or IBufferWriter&lt;byte&gt; without a requested data model version; fixes #421
            - [Update] ToJsonString no longer copies the UTF-8 buffer before decoding
        </PackageReleaseNotes>
    </PropertyGroup>

    <ItemGroup>
        <ProjectReference Include="..\CDP4DalCommon\CDP4DalCommon.csproj" />
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="System.Memory" />
        <PackageReference Include="System.Text.Json" />
    </ItemGroup>

    <ItemGroup>
        <Folder Include="AutoGenDtoDeserializer\" />
        <Folder Include="AutoGenDtoSerializer\" />
        <Folder Include="Helper\" />
    </ItemGroup>

</Project>
